---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { buildBreadcrumbSchema, buildFaqSchema, buildServiceSchema, type FaqItem } from '@/lib/schema';
import { SITE_CONFIG } from '@/config/site';

interface Props {
  title: string;
  description: string;
  seoTitle: string;
  seoDescription: string;
  category: string;
  targetAudience: string[];
  deliverables: string[];
  stack: string[];
  faqs: FaqItem[];
  slug: string;
}

const {
  title,
  description,
  seoTitle,
  seoDescription,
  category,
  targetAudience,
  deliverables,
  stack,
  faqs,
  slug,
} = Astro.props;

const canonical = `${SITE_CONFIG.domain}/servicios/${slug}`;
const schemas: Record<string, unknown>[] = [
  buildServiceSchema({ name: title, description: seoDescription, url: canonical, serviceType: category }),
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Servicios', url: '/servicios' },
    { name: title, url: `/servicios/${slug}` },
  ]),
];
if (faqs.length > 0) schemas.push(buildFaqSchema(faqs));
---

<BaseLayout title={seoTitle} description={seoDescription} canonical={canonical} schemas={schemas}>
  <section class="border-b border-[var(--border-subtle)] py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 font-mono text-xs text-[var(--text-muted)]">
        <a href="/" class="hover:text-[var(--text-primary)]">Inicio</a>
        <span>/</span>
        <a href="/servicios" class="hover:text-[var(--text-primary)]">Servicios</a>
        <span>/</span>
        <span class="text-[var(--accent-primary)]">{category}</span>
      </nav>

      <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.12] sm:text-4xl lg:text-5xl">
        {title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-[var(--text-secondary)]">
        {description}
      </p>

      <div class="mt-8 flex flex-wrap gap-3.5">
        <a href={`/cotizar?servicio=${encodeURIComponent(title)}`} class="btn-primary">
          Cotizar este servicio
        </a>
        <a href={SITE_CONFIG.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="space-y-10 lg:col-span-8">
        <div class="space-y-4 text-base leading-relaxed text-[var(--text-secondary)]">
          <slot />
        </div>

        <div class="spotlight-card bg-[var(--bg-surface)] p-6 sm:p-7">
          <h2 class="text-lg font-extrabold text-[var(--text-primary)]">¿Para quién es ideal?</h2>
          <ul class="mt-4 space-y-2.5 text-sm text-[var(--text-secondary)]">
            {
              targetAudience.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent-primary)]" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {
          faqs.length > 0 && (
            <div>
              <h2 class="text-xl font-extrabold text-[var(--text-primary)]">Preguntas frecuentes</h2>
              <div class="mt-4 space-y-3">
                {faqs.map((faq) => (
                  <details class="spotlight-card bg-[var(--bg-surface)] p-5">
                    <summary class="cursor-pointer font-bold text-[var(--text-primary)]">
                      {faq.question}
                    </summary>
                    <p class="mt-3 text-sm text-[var(--text-muted)]">{faq.answer}</p>
                  </details>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <aside class="space-y-6 lg:col-span-4">
        <div class="spotlight-card bg-[var(--bg-surface)] p-6">
          <h2 class="font-mono text-xs font-bold tracking-wider text-[var(--accent-primary)] uppercase">
            Qué incluye la entrega
          </h2>
          <ul class="mt-4 space-y-3 text-sm text-[var(--text-secondary)]">
            {
              deliverables.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--accent-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="spotlight-card bg-[var(--bg-surface)] p-6">
          <h2 class="font-mono text-xs font-bold tracking-wider text-[var(--text-muted)] uppercase">
            Tecnologías aplicadas
          </h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              stack.map((tech) => (
                <span class="rounded-full border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-3 py-1 font-mono text-xs text-[var(--text-secondary)]">
                  {tech}
                </span>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  <FinalCta />
</BaseLayout>

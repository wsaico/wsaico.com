---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { buildBreadcrumbSchema } from '@/lib/schema';
import { SITE_CONFIG } from '@/config/site';

interface Props {
  title: string;
  subtitle: string;
  summary: string;
  problem: string;
  solution: string;
  result: string;
  metrics: string[];
  stack: string[];
  category: string;
  liveUrl?: string;
  liveCtaQuestion?: string;
  liveCtaLabel?: string;
  anonymizedNotice?: string;
  slug: string;
}

const {
  title,
  subtitle,
  summary,
  problem,
  solution,
  result,
  metrics,
  stack,
  category,
  liveUrl,
  liveCtaQuestion,
  liveCtaLabel,
  anonymizedNotice,
  slug,
} = Astro.props;

const canonical = `${SITE_CONFIG.domain}/proyectos/${slug}`;
const breadcrumb = buildBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Proyectos', url: '/proyectos' },
  { name: title, url: `/proyectos/${slug}` },
]);
---

<BaseLayout title={`${title} — Caso de Estudio | WSAICO`} description={summary} canonical={canonical} schemas={[breadcrumb]}>
  <section class="border-b border-[var(--border-subtle)] py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 font-mono text-xs text-[var(--text-muted)]">
        <a href="/" class="hover:text-[var(--text-primary)]">Inicio</a>
        <span>/</span>
        <a href="/proyectos" class="hover:text-[var(--text-primary)]">Proyectos</a>
        <span>/</span>
        <span class="text-[var(--accent-primary)]">{category}</span>
      </nav>

      <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.12] sm:text-4xl lg:text-5xl">
        {title}
      </h1>
      <p class="mt-2 text-lg font-bold text-[var(--accent-primary)]">{subtitle}</p>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-[var(--text-secondary)]">{summary}</p>

      {
        liveUrl && (
          <div class="spotlight-card mt-8 flex flex-col items-start justify-between gap-4 border border-[var(--border-accent)] bg-[var(--accent-primary-soft)] p-5 sm:flex-row sm:items-center">
            <div>
              <p class="font-mono text-xs font-bold text-[var(--accent-primary)] uppercase">
                Plataforma en vivo
              </p>
              <p class="mt-1 text-base font-extrabold text-[var(--text-primary)]">
                {liveCtaQuestion ?? `¿Quieres probar ${title}?`}
              </p>
              <p class="font-mono text-xs text-[var(--text-muted)]">{liveUrl}</p>
            </div>
            <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary shrink-0">
              <span>{liveCtaLabel ?? 'Abrir plataforma'}</span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-5xl space-y-12 px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-3">
        <div class="spotlight-card bg-[var(--bg-surface)] p-6">
          <p class="font-mono text-xs font-bold text-[var(--text-subtle)] uppercase">01 · Problema</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">{problem}</p>
        </div>
        <div class="spotlight-card bg-[var(--bg-surface)] p-6">
          <p class="font-mono text-xs font-bold text-[var(--accent-primary)] uppercase">02 · Solución</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">{solution}</p>
        </div>
        <div class="spotlight-card bg-[var(--bg-surface)] p-6">
          <p class="font-mono text-xs font-bold text-emerald-500 uppercase">03 · Resultado</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">{result}</p>
        </div>
      </div>

      <div class="grid gap-10 lg:grid-cols-12">
        <div class="space-y-4 text-base leading-relaxed text-[var(--text-secondary)] lg:col-span-8">
          <slot />
          {
            anonymizedNotice && (
              <p class="mt-6 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4 font-mono text-xs text-[var(--text-muted)]">
                Nota técnica: {anonymizedNotice}
              </p>
            )
          }
        </div>

        <aside class="space-y-6 lg:col-span-4">
          {
            metrics.length > 0 && (
              <div class="spotlight-card bg-[var(--bg-surface)] p-6">
                <h2 class="font-mono text-xs font-bold text-[var(--accent-primary)] uppercase">
                  Capacidades clave
                </h2>
                <ul class="mt-4 space-y-2.5 text-sm text-[var(--text-secondary)]">
                  {metrics.map((m) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent-primary)]" />
                      <span>{m}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="spotlight-card bg-[var(--bg-surface)] p-6">
            <h2 class="font-mono text-xs font-bold text-[var(--text-muted)] uppercase">
              Stack utilizado
            </h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                stack.map((tech) => (
                  <span class="rounded-full border border-[var(--border-subtle)] px-3 py-1 font-mono text-xs text-[var(--text-secondary)]">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>

          <a href={`/cotizar?proyecto=${encodeURIComponent(title)}`} class="btn-primary w-full justify-center">
            Cotizar un sistema similar
          </a>
        </aside>
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>

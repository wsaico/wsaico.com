---
import { SITE_CONFIG } from '@/config/site';
---

<div id="wsaico-wa-widget" class="fixed right-5 bottom-5 z-50 flex flex-col items-end gap-3">
  <!-- Globo de mensaje animado con llamado a la acción -->
  <div
    id="wa-speech-bubble"
    class="pointer-events-auto relative hidden max-w-[260px] origin-bottom-right rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-surface)] p-3.5 text-left shadow-2xl transition-all duration-300"
  >
    <button
      type="button"
      id="wa-close-bubble"
      aria-label="Cerrar mensaje"
      class="absolute top-2 right-2 flex h-5 w-5 cursor-pointer items-center justify-center rounded-full text-xs text-[var(--text-muted)] hover:bg-[var(--bg-surface-2)] hover:text-[var(--text-primary)]"
    >
      ×
    </button>
    <a
      href={SITE_CONFIG.contact.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block pr-4 no-underline"
    >
      <p class="text-xs font-extrabold text-[var(--text-primary)]">
        Wilber Saico · WSAICO
      </p>
      <p class="mt-1 text-xs leading-snug text-[var(--text-secondary)]">
        Hola, ¿tienes un proyecto o sistema en mente? Escríbeme por WhatsApp.
      </p>
    </a>
  </div>

  <!-- Burbuja con fotografía de Wilber + ícono de WhatsApp -->
  <a
    href={SITE_CONFIG.contact.whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="wa-avatar-trigger"
    aria-label="Hablar por WhatsApp con Wilber Saico"
    class="group relative flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-tr from-[#0B1B3F] to-[#2563EB] p-0.5 shadow-[0_12px_30px_rgba(37,99,235,0.45)] transition-transform duration-300 hover:scale-108"
  >
    <div class="h-full w-full overflow-hidden rounded-full bg-[#0B1B3F]">
      <img
        src="/brand/wilber-cutout.webp"
        alt="Wilber Saico — WhatsApp"
        width="80"
        height="80"
        class="h-full w-full scale-125 object-cover object-top transition-transform duration-300 group-hover:scale-135"
      />
    </div>

    <!-- Insignia oficial de WhatsApp en la esquina inferior derecha -->
    <span class="absolute -right-0.5 -bottom-0.5 flex h-7 w-7 items-center justify-center rounded-full bg-[#25D366] text-white shadow-md ring-2 ring-[var(--bg-canvas)]">
      <svg
        class="h-4 w-4"
        viewBox="0 0 32 32"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M16.004 3.2c-7.058 0-12.8 5.742-12.8 12.8 0 2.256.592 4.46 1.714 6.404L3.1 29l6.766-1.774A12.74 12.74 0 0 0 16.004 28.8c7.058 0 12.8-5.742 12.8-12.8s-5.742-12.8-12.8-12.8zm0 23.36a10.52 10.52 0 0 1-5.366-1.468l-.384-.228-4.014 1.052 1.072-3.914-.25-.4a10.52 10.52 0 0 1-1.618-5.602c0-5.822 4.738-10.56 10.56-10.56 5.822 0 10.56 4.738 10.56 10.56 0 5.822-4.738 10.56-10.56 10.56zm5.792-7.912c-.318-.16-1.88-.928-2.172-1.034-.292-.106-.504-.16-.716.16-.212.318-.82 1.034-1.006 1.246-.186.212-.37.238-.688.08-.318-.16-1.342-.494-2.556-1.576-.944-.842-1.582-1.882-1.768-2.2-.186-.318-.02-.49.14-.648.144-.144.318-.37.478-.556.16-.186.212-.318.318-.53.106-.212.054-.398-.026-.556-.08-.16-.716-1.724-.982-2.36-.258-.62-.52-.536-.716-.546-.186-.01-.398-.01-.61-.01-.212 0-.556.08-.848.398-.292.318-1.112 1.086-1.112 2.65 0 1.562 1.138 3.072 1.298 3.284.16.212 2.24 3.42 5.426 4.796.758.328 1.35.524 1.81.67.76.242 1.452.208 2 .126.61-.09 1.88-.768 2.144-1.51.266-.742.266-1.378.186-1.51-.08-.132-.292-.212-.61-.37z" />
      </svg>
    </span>
  </a>
</div>

<script is:inline>
  (function () {
    function playNotificationChime() {
      try {
        var AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return false;
        var ctx = new AudioCtx();
        if (ctx.state === 'suspended') {
          ctx.resume();
        }
        var now = ctx.currentTime;

        // Dos notas suaves estilo notificación moderna (Mi5 -> Si5)
        var freqs = [659.25, 987.77];
        freqs.forEach(function (f, idx) {
          var osc = ctx.createOscillator();
          var gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(f, now + idx * 0.11);

          gain.gain.setValueAtTime(0.0001, now + idx * 0.11);
          gain.gain.exponentialRampToValueAtTime(0.11, now + idx * 0.11 + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.11 + 0.28);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + idx * 0.11);
          osc.stop(now + idx * 0.11 + 0.3);
        });
        return true;
      } catch (e) {
        return false;
      }
    }

    function initWaBubble() {
      var bubble = document.getElementById('wa-speech-bubble');
      var closeBtn = document.getElementById('wa-close-bubble');
      var trigger = document.getElementById('wa-avatar-trigger');
      if (!bubble) return;

      closeBtn &&
        closeBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          bubble.classList.add('hidden');
          try {
            sessionStorage.setItem('wsaico-wa-closed', '1');
          } catch (err) {}
        });

      trigger &&
        trigger.addEventListener('mouseenter', function () {
          bubble.classList.remove('hidden');
        });

      var alreadyClosed = false;
      try {
        alreadyClosed = sessionStorage.getItem('wsaico-wa-closed') === '1';
      } catch (err) {}

      if (!alreadyClosed) {
        setTimeout(function () {
          bubble.classList.remove('hidden');
          bubble.animate(
            [
              { opacity: 0, transform: 'translateY(10px) scale(0.95)' },
              { opacity: 1, transform: 'translateY(0) scale(1)' },
            ],
            { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          );
        }, 2200);

        // Reproduce el sonido sutil en la primera interacción del usuario con la página
        if (!window.__wsaicoChimePlayed) {
          var onFirstInteract = function () {
            if (window.__wsaicoChimePlayed) return;
            window.__wsaicoChimePlayed = true;
            playNotificationChime();
            window.removeEventListener('pointerdown', onFirstInteract);
            window.removeEventListener('scroll', onFirstInteract);
          };
          window.addEventListener('pointerdown', onFirstInteract, { once: true, passive: true });
          window.addEventListener('scroll', onFirstInteract, { once: true, passive: true });
        }
      }
    }

    initWaBubble();
    document.addEventListener('astro:after-swap', initWaBubble);
  })();
</script>

---
---

<div
  id="wsaico-legal-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="legal-modal-title"
  class="fixed inset-x-0 bottom-0 z-[60] hidden p-4 sm:inset-auto sm:bottom-5 sm:left-5 sm:max-w-md sm:p-0"
>
  <div class="surface-glass rounded-3xl border border-[var(--border-strong)] bg-[var(--bg-surface)] p-6 shadow-2xl">
    <div class="flex items-start justify-between gap-3">
      <div>
        <span class="inline-block rounded-full bg-[var(--accent-primary-soft)] px-3 py-1 font-mono text-[10px] font-bold tracking-wider text-[var(--accent-primary)] uppercase">
          Privacidad y Cumplimiento
        </span>
        <h2 id="legal-modal-title" class="mt-2.5 text-base font-extrabold text-[var(--text-primary)]">
          Tu privacidad y términos de uso
        </h2>
      </div>
    </div>

    <p class="mt-2.5 text-xs leading-relaxed text-[var(--text-muted)]">
      Utilizamos almacenamiento técnico esencial para recordar tu tema visual, proteger nuestros formularios y mejorar tu experiencia. Al continuar, aceptas nuestra{' '}
      <a href="/politica-privacidad" class="font-semibold text-[var(--accent-primary)] underline">
        Política de Privacidad
      </a>,{' '}
      <a href="/terminos" class="font-semibold text-[var(--accent-primary)] underline">
        Términos y Condiciones
      </a>{' '}
      y{' '}
      <a href="/politica-cookies" class="font-semibold text-[var(--accent-primary)] underline">
        Política de Cookies
      </a>.
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-2.5">
      <button
        type="button"
        id="legal-accept-all"
        class="btn-primary flex-1 cursor-pointer !py-2.5 !px-4 !text-xs"
      >
        Aceptar todo
      </button>
      <button
        type="button"
        id="legal-accept-essential"
        class="btn-secondary cursor-pointer !py-2.5 !px-4 !text-xs"
      >
        Solo esenciales
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function initLegalModal() {
      var modal = document.getElementById('wsaico-legal-modal');
      if (!modal) return;

      var consent = null;
      try {
        consent = localStorage.getItem('wsaico-legal-consent');
      } catch (e) {}

      if (!consent) {
        setTimeout(function () {
          modal.classList.remove('hidden');
          modal.animate(
            [
              { opacity: 0, transform: 'translateY(16px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 300, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          );
        }, 700);
      }

      function saveConsent(level) {
        try {
          localStorage.setItem(
            'wsaico-legal-consent',
            JSON.stringify({ level: level, acceptedAt: new Date().toISOString() }),
          );
        } catch (e) {}
        modal.classList.add('hidden');
      }

      var acceptAll = document.getElementById('legal-accept-all');
      var acceptEssential = document.getElementById('legal-accept-essential');

      acceptAll &&
        acceptAll.addEventListener('click', function () {
          saveConsent('all');
        });

      acceptEssential &&
        acceptEssential.addEventListener('click', function () {
          saveConsent('essential');
        });
    }

    initLegalModal();
    document.addEventListener('astro:after-swap', initLegalModal);
  })();
</script>

---
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-PE', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
---

<section class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-18 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHeader
        eyebrow="Bitácora Técnica"
        title="Artículos prácticos sobre sistemas, SSOMA y rendimiento."
        description="Guías reales pensadas para gerentes, jefes de operaciones y responsables de tecnología en Perú."
      />
      <a href="/blog" class="btn-secondary shrink-0 self-start md:self-auto">
        Ir al blog
      </a>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        recentPosts.map((post) => (
          <article class="spotlight-card group flex flex-col justify-between p-6">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-[11px] font-semibold text-[var(--accent-primary)]">
                  {post.data.category}
                </span>
                <time datetime={post.data.pubDate.toISOString()} class="font-mono text-[11px] text-[var(--text-subtle)]">
                  {formatDate(post.data.pubDate)}
                </time>
              </div>

              <h3 class="mt-3.5 text-lg font-bold leading-snug text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>

              <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-muted)] line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <a
              href={`/blog/${post.id}`}
              class="mt-6 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--accent-primary)]"
            >
              Leer artículo
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

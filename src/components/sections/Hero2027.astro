---
---

<section class="mx-auto max-w-7xl px-4 pt-4 pb-8 sm:px-6 lg:px-8">
  <!-- Contenedor Escultórico Oscuro (#0B1B3F) -->
  <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-br from-[#061029] via-[#0B1B3F] to-[#081533] px-6 pt-10 pb-0 text-white shadow-2xl ring-1 ring-white/10 sm:rounded-[40px] sm:px-12 sm:pt-14 lg:px-16 lg:pt-16">
    <!-- Anillos orbitales concéntricos detrás del retrato -->
    <div
      class="pointer-events-none absolute top-1/2 right-[8%] h-[540px] w-[540px] -translate-y-1/2 rounded-full border border-blue-400/10"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute top-1/2 right-[12%] h-[410px] w-[410px] -translate-y-1/2 rounded-full border border-blue-400/15"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute top-1/2 right-[16%] h-[280px] w-[280px] -translate-y-1/2 rounded-full border border-blue-400/20"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -top-20 right-[5%] h-[480px] w-[480px] rounded-full bg-[radial-gradient(circle,rgba(37,99,235,0.42)_0%,transparent_68%)] blur-2xl"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 grid items-end gap-10 lg:grid-cols-12">
      <!-- Columna Izquierda: Titular de alto impacto + CTA + Credenciales -->
      <div class="pb-10 sm:pb-14 lg:col-span-7 lg:pb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-400/25 bg-blue-500/10 px-4 py-1.5 backdrop-blur-md">
          <span class="font-mono text-xs font-semibold tracking-wider text-blue-200 uppercase">
            ARQUITECTURA DE SOFTWARE · +10 AÑOS DE EXPERIENCIA
          </span>
        </div>

        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white leading-[1.06] sm:text-5xl lg:text-[3.75rem]">
          Simplifica Procesos.
          <span class="block">
            Escala tu Negocio con{' '}
            <span class="bg-gradient-to-r from-[#3B82F6] via-[#60A5FA] to-[#2563EB] bg-clip-text text-transparent">
              Software a Medida.
            </span>
          </span>
        </h1>

        <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">
          Plataformas web operativas, aplicaciones móviles y automatización de procesos diseñadas desde cero con código limpio para empresas modernas.
        </p>

        <!-- Botones principales -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/cotizar" class="btn-primary !px-7 !py-3.5 !text-base">
            <span>Solicitar Cotización</span>
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-white/20">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </a>

          <a
            href="/proyectos"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3.5 text-sm font-bold text-white backdrop-blur-md transition-all hover:-translate-y-0.5 hover:border-blue-400/50 hover:bg-white/10"
          >
            <span>Explorar Proyectos</span>
          </a>
        </div>

        <!-- Píldora de credenciales (sin puntos verdes ni enlaces repetitivos) -->
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <div class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/[0.07] p-1.5 pr-5 backdrop-blur-md">
            <div class="flex -space-x-2">
              <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#0B1B3F] bg-[#2563EB] font-mono text-[10px] font-bold text-white">
                TS
              </span>
              <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#0B1B3F] bg-slate-800 font-mono text-[10px] font-bold text-blue-300">
                NX
              </span>
              <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#0B1B3F] bg-blue-700 font-mono text-[10px] font-bold text-white">
                SB
              </span>
              <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#0B1B3F] bg-indigo-600 font-mono text-[10px] font-bold text-white">
                RN
              </span>
            </div>
            <div class="text-xs">
              <p class="font-bold text-white">Wilber Saico · Full-Stack Architect</p>
              <p class="text-[11px] text-slate-300">Next.js · Astro · React Native · Supabase</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Retrato recortado limpio (sin etiquetas flotantes invasivas) -->
      <div class="relative flex justify-center lg:col-span-5 lg:justify-end">
        <div class="relative w-full max-w-[390px] pt-2">
          <div
            class="pointer-events-none absolute inset-x-6 bottom-0 h-64 rounded-t-full bg-gradient-to-t from-[#2563EB]/35 via-[#2563EB]/10 to-transparent blur-2xl"
            aria-hidden="true"
          ></div>

          <img
            src="/brand/wilber-cutout.webp"
            alt="Wilber Saico — Arquitecto de Software Full-Stack en WSAICO"
            width="768"
            height="1024"
            loading="eager"
            fetchpriority="high"
            class="relative z-10 mx-auto block h-auto w-full max-w-[350px] select-none object-contain object-bottom drop-shadow-[0_20px_35px_rgba(0,0,0,0.65)] sm:max-w-[385px]"
          />
        </div>
      </div>
    </div>
  </div>
</section>

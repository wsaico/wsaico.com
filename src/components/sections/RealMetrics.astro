---
/* Bloque inspirado directamente en la sección "10,000+ Happy SaaS Companies Trust Us" de la referencia,
   con las 4 tarjetas flotantes escalonadas a la derecha y animaciones de conteo reales */
---

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="reveal-on-scroll relative overflow-hidden rounded-[32px] border border-[var(--border-subtle)] bg-[var(--bg-surface-2)] px-6 py-12 shadow-sm sm:rounded-[40px] sm:px-12 sm:py-16 lg:px-16">
    <!-- Círculos decorativos de fondo sutiles -->
    <div
      class="pointer-events-none absolute -top-24 right-1/4 h-96 w-96 rounded-full border border-[#2563EB]/10"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 grid items-center gap-12 lg:grid-cols-12">
      <!-- Columna Izquierda: Titular con trazo curvo + Texto + Botón -->
      <div class="lg:col-span-6">
        <h2 class="text-3xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.12] sm:text-4xl lg:text-[2.75rem]">
          +10 Años Creando Software que Impulsa Empresas
          <span class="mt-2 block">
            <svg class="h-3 w-44 text-[#2563EB]" viewBox="0 0 180 12" fill="none" aria-hidden="true">
              <path d="M2 9.5C45 2.5 125 2.5 178 8.5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
            </svg>
          </span>
        </h2>

        <p class="mt-5 max-w-lg text-base leading-relaxed text-[var(--text-muted)] sm:text-lg">
          Desde sistemas de gestión operativa en tiempo real hasta aplicaciones móviles y plataformas empresariales: diseño código limpio que elimina procesos manuales y escala sin límites.
        </p>

        <div class="mt-8">
          <a href="/proceso" class="btn-primary">
            <span>Ver Cómo Trabajo</span>
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/20">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: 4 Tarjetas Flotantes Escalonadas (Staggered Grid como la referencia) -->
      <div class="lg:col-span-6">
        <div class="grid grid-cols-2 gap-4 sm:gap-6">
          <!-- Columna 1 de tarjetas (desplazada hacia abajo para efecto escalonado) -->
          <div class="space-y-4 sm:mt-12 sm:space-y-6">
            <div class="spotlight-card rounded-3xl bg-[var(--bg-surface)] p-6 text-center shadow-xl">
              <p class="text-3xl font-extrabold tracking-tight text-[#2563EB] sm:text-4xl">
                <span class="counter-value" data-target="100">100</span>%
              </p>
              <p class="mt-2 text-xs font-bold text-[var(--text-primary)] sm:text-sm">
                Código Propio
              </p>
              <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">
                Sin licencias por usuario
              </p>
            </div>

            <div class="spotlight-card rounded-3xl bg-[var(--bg-surface)] p-6 text-center shadow-xl">
              <p class="text-3xl font-extrabold tracking-tight text-[#2563EB] sm:text-4xl">
                +<span class="counter-value" data-target="10">10</span>
              </p>
              <p class="mt-2 text-xs font-bold text-[var(--text-primary)] sm:text-sm">
                Años de Experiencia
              </p>
              <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">
                Arquitectura Full-Stack
              </p>
            </div>
          </div>

          <!-- Columna 2 de tarjetas -->
          <div class="space-y-4 sm:space-y-6">
            <div class="spotlight-card rounded-3xl bg-[var(--bg-surface)] p-6 text-center shadow-xl">
              <p class="text-3xl font-extrabold tracking-tight text-[#2563EB] sm:text-4xl">
                <span class="counter-value" data-target="99">99</span>+
              </p>
              <p class="mt-2 text-xs font-bold text-[var(--text-primary)] sm:text-sm">
                Google PageSpeed
              </p>
              <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">
                Core Web Vitals en verde
              </p>
            </div>

            <div class="spotlight-card rounded-3xl bg-[var(--bg-surface)] p-6 text-center shadow-xl">
              <p class="text-3xl font-extrabold tracking-tight text-[#2563EB] sm:text-4xl">
                99.9%
              </p>
              <p class="mt-2 text-xs font-bold text-[var(--text-primary)] sm:text-sm">
                Disponibilidad Cloud
              </p>
              <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">
                Vercel & Supabase Edge
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCounters() {
    const els = document.querySelectorAll<HTMLElement>('.counter-value');
    if (!els.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.target || '0');
          if (!target) return;

          const duration = 1000;
          const start = performance.now();
          const tick = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = String(Math.round(target * eased));
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          observer.unobserve(el);
        });
      },
      { threshold: 0.35 },
    );

    els.forEach((el) => observer.observe(el));
  }

  initCounters();
  document.addEventListener('astro:after-swap', initCounters);
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { buildBreadcrumbSchema } from '@/lib/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const breadcrumb = buildBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
]);
---

<BaseLayout
  title="Servicios de Desarrollo de Software, SSOMA y SEO Técnico | WSAICO"
  description="Sistemas web a medida, plataformas SSOMA para Ley SST Perú, aplicaciones móviles React Native, automatización, tiendas online y SEO/SEM."
  schemas={[breadcrumb]}
>
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Catálogo de Servicios"
        title="Ingeniería aplicada a resolver problemas de negocio."
        description="Más de 10 años construyendo sistemas estables con código limpio y tecnología actual en Perú."
      />

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <a href={`/servicios/${service.id}`} class="spotlight-card group flex flex-col justify-between p-7 no-underline">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="rounded-full bg-[var(--accent-primary-soft)] px-3 py-1 font-mono text-[11px] font-semibold text-[var(--accent-primary)]">
                    {service.data.category}
                  </span>
                  <span class="font-mono text-xs text-[var(--text-subtle)]">0{service.data.order}</span>
                </div>
                <h2 class="mt-5 text-xl font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">
                  {service.data.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
                  {service.data.description}
                </p>
              </div>
              <div class="mt-6 flex items-center justify-between border-t border-[var(--border-subtle)] pt-4 text-xs font-semibold text-[var(--accent-primary)]">
                <span>Ver alcance y entregables</span>
                <span>→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>

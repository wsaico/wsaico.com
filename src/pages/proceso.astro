---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ProcessTimeline from '@/components/sections/ProcessTimeline.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { buildBreadcrumbSchema } from '@/lib/schema';

const breadcrumb = buildBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Proceso', url: '/proceso' },
]);
---

<BaseLayout
  title="Cómo Trabajo — Metodología, Pagos por Hitos y Garantía | WSAICO"
  description="Conoce el proceso de trabajo en 5 etapas, entregables semanales, pagos por hitos y garantía de soporte técnico en WSAICO."
  schemas={[breadcrumb]}
>
  <section class="border-b border-[var(--border-subtle)] pt-14 pb-6 sm:pt-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Transparencia Operativa"
        title="Cómo convertimos un problema operativo en un sistema estable."
        description="Trabajo con un esquema predecible: entregas verificables cada semana, comunicación directa y pagos atados a avances reales."
      />
    </div>
  </section>

  <ProcessTimeline />

  <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="spotlight-card p-7">
        <p class="font-mono text-xs font-semibold text-[var(--accent-primary)] uppercase">01 · Qué necesito de ti</p>
        <h2 class="mt-2 text-xl font-bold text-[var(--text-primary)]">Tu conocimiento del negocio</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
          Un par de ejemplos de tus formatos actuales (Excel, actas físicas o capturas) y una persona clave de tu equipo disponible para validar los prototipos y entregas semanales.
        </p>
      </div>

      <div class="spotlight-card p-7">
        <p class="font-mono text-xs font-semibold text-[var(--accent-primary)] uppercase">02 · Cómo nos comunicamos</p>
        <h2 class="mt-2 text-xl font-bold text-[var(--text-primary)]">Canal directo sin intermediarios</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
          Coordinamos por WhatsApp y videollamadas breves de seguimiento semanal sobre un enlace de pruebas en vivo donde ves funcionar cada módulo antes de aprobarlo.
        </p>
      </div>

      <div class="spotlight-card p-7">
        <p class="font-mono text-xs font-semibold text-[var(--accent-primary)] uppercase">03 · Forma de pago</p>
        <h2 class="mt-2 text-xl font-bold text-[var(--text-primary)]">Por hitos verificables</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
          Dividimos la inversión según el tamaño del sistema (generalmente inicio, entrega de módulos principales y pase a producción). Nunca pagas el total por adelantado.
        </p>
      </div>

      <div class="spotlight-card p-7">
        <p class="font-mono text-xs font-semibold text-[var(--accent-primary)] uppercase">04 · Garantía de soporte</p>
        <h2 class="mt-2 text-xl font-bold text-[var(--text-primary)]">Acompañamiento post-lanzamiento</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
          Todo sistema incluye periodo de garantía técnica ante cualquier incidencia tras salir a producción, además de capacitación práctica para tus usuarios finales.
        </p>
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '@/layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ProjectLayout
  title={project.data.title}
  subtitle={project.data.subtitle}
  summary={project.data.summary}
  problem={project.data.problem}
  solution={project.data.solution}
  result={project.data.result}
  metrics={project.data.metrics}
  stack={project.data.stack}
  category={project.data.category}
  liveUrl={project.data.liveUrl}
  liveCtaQuestion={project.data.liveCtaQuestion}
  liveCtaLabel={project.data.liveCtaLabel}
  anonymizedNotice={project.data.anonymizedNotice}
  slug={project.id}
>
  <Content />
</ProjectLayout>

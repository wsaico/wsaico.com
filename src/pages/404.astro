---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada (404) | WSAICO" description="La ruta solicitada no existe en wsaico.com." noindex={true}>
  <section class="py-24 text-center">
    <div class="mx-auto max-w-xl px-4">
      <p class="font-mono text-sm font-semibold text-[var(--accent-primary)]">ERROR 404</p>
      <h1 class="mt-3 text-3xl font-extrabold text-[var(--text-primary)] sm:text-4xl">
        Esta ruta no existe.
      </h1>
      <p class="mt-4 text-base text-[var(--text-muted)]">
        Es posible que el enlace haya cambiado. Puedes volver al inicio o revisar nuestros servicios y proyectos en producción.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3.5">
        <a href="/" class="btn-primary">Ir al inicio</a>
        <a href="/proyectos" class="btn-secondary">Ver proyectos</a>
      </div>
    </div>
  </section>
</BaseLayout>
